__pycache__/
*.pyc
venv/
.venv/
.claude/settings.local.json
.ruff_cache/
.pytest_cache/

# Fetched-document cache — regenerable via document_fetch.fetch_document(),
# not meant to be versioned (grows unbounded, binary PDFs).
data/raw/

# Claude response cache, keyed on (prompt_version, model, input hash) — see llm.py.
.cache/

# Latest eval run's machine-readable output — regenerated by every run_eval.py
# invocation. evals/baseline.json (the committed snapshot) is not ignored.
evals/results/

# Extractions awaiting human review — runtime state, not source. Accepted/edited
# decisions get exported into evals/gold/ (committed); the queue itself isn't.
data/review_queue/

# Per-run, per-city health metrics (metrics/collect.py) — runtime observability
# data, regenerated by every run, not something to version.
data/metrics/

# Internal build spec — guides local development only, not for the public repo.
SPEC.md
